# ==========================================================================
# AthenIQ — environment configuration template
# Copy to `.env` (or run ./setup.sh) and fill in real values.
# Never commit `.env`. Platform SecretOps is Cerulean Vault (HashiCorp Vault,
# KV v2, hosted by Cerulean) — see docs/stack.md for the contract and how to
# move plaintext values in with scripts/vault-migrate.py.
# ==========================================================================

# --- General ----------------------------------------------------------------
APP_NAME=AthenIQ
# Base domains for public surfaces (DNS + TLS provisioned by Cerulean)
BASE_DOMAIN=learn.innotel.us
LMS_HOST=learn.innotel.us
CMS_HOST=studio.innotel.us
CLASSROOM_HOST=classroom.innotel.us

# --- Bind addresses / ports -------------------------------------------------
# OmniRoute model gateway (OpenAI-compatible; API and dashboard share the port).
# The platform runs ONE OmniRoute, in Group 2 (`2-voice`), on its own host —
# 192.168.1.46. Its own port is not a routable target: Cerulean SSO is the
# gateway's only gate, so 20128 is published on that host's loopback and bridge
# alone, and every other caller dials the identity-aware proxy in front of it,
# :20129, which exempts /v1 for API clients. OMNIROUTE_PORT is the gateway's own
# listener, not the port a caller dials. Single-host dev where the gateway runs
# on this box: http://host.docker.internal:20129/v1.
OMNIROUTE_BASE_URL=http://192.168.1.46:20129/v1
OMNIROUTE_PORT=20128
OMNIROUTE_API_KEY=change-me-omniroute-api-key
OMNIROUTE_MODEL=auto
REQUIRE_API_KEY=true

# --- Authentik (OIDC identity provider) -------------------------------------
# Cerulean identity provider: application slug `atheniq-lms` registered on
# the shared Authentik (auth.cerulean.innotel.us). Realized values live in
# .env; Open edX is wired via contrib/tutor-ceruleansso (TPA backend `oidc`,
# redirect URIs https://learn.innotel.us/auth/complete/oidc/ + studio).
OIDC_ISSUER_URL=https://auth.cerulean.innotel.us/application/o/atheniq-lms/
OIDC_CLIENT_ID=atheniq-lms
OIDC_CLIENT_SECRET=change-me-oidc-client-secret
OIDC_SCOPES="openid profile email"
IDP_ADMIN_GROUP=atheniq-admins

# --- OpenMAIC (AI classroom) persistence profile ----------------------------
# docker compose --profile openmaic up -d
OPENMAIC_DB_HOST=openmaic-postgres
OPENMAIC_DB_PORT=5433
OPENMAIC_DB_NAME=openmaic
OPENMAIC_DB_USER=openmaic
OPENMAIC_DB_PASSWORD=change-me-openmaic-db
OPENMAIC_DATABASE_URL=postgres://openmaic:change-me-openmaic-db@127.0.0.1:5433/openmaic
PERSISTENCE_DEV_TOKEN=change-me-openmaic-persistence-token

# --- Convex (self-hosted realtime backend) ----------------------------------
# Run with `make convex-up`; the backend and dashboard bind loopback only.
# Both default to `latest`. To pin, set them independently — the two images are
# tagged differently (the backend publishes commit-sha tags; the dashboard does
# not carry them), so one shared value would fail to pull the dashboard.
# Verified backend pin (the precompiled-2026-09-11 release):
#   CONVEX_BACKEND_VERSION=157eb19fd30d085cdb5ec785fdb3574f84cabfda
CONVEX_BACKEND_VERSION=latest
CONVEX_DASHBOARD_VERSION=latest
CONVEX_BACKEND_PORT=3210
CONVEX_SITE_PORT=3211
CONVEX_DASHBOARD_PORT=6791
CONVEX_INSTANCE_SECRET=          # generated by setup.sh; keeps sessions valid across restarts
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210

# --- ONYX (object storage — classroom media, roadmap V2) ---------------------
# Optional. Leave ONYX_S3_ENDPOINT blank and Convex keeps files on its own
# volume. Set the endpoint + key pair (and the bucket names below) to move
# classroom media onto ONYX's S3-compatible object store instead:
#   ONYX_S3_ENDPOINT  http(s)://<onyx-host>:<objectstore-port>  (2090 on the
#                     ONYX host; storage.onyx.innotel.us in a proxied deploy)
# ONYX owns buckets; `make onyx-buckets` creates the two below through the S3
# API (SigV4), and `make onyx-check` verifies them read-only. The access/secret
# pair is ONYX's S3 credential (SecretOps: S3_ACCESS_KEY/S3_SECRET_KEY at
# vault://cerulean/onyx) — the same credential every ONYX consumer uses.
ONYX_S3_ENDPOINT=
ONYX_S3_REGION=us-east-1
ONYX_S3_FORCE_PATH_STYLE=true
ONYX_S3_ACCESS_KEY=
ONYX_S3_SECRET_KEY=
ONYX_S3_BUCKET_FILES=atheniq-files
ONYX_S3_BUCKET_EXPORTS=atheniq-exports

# Minted from the running backend with `make convex-key` (never generated
# locally — only the backend can sign a valid key).
CONVEX_SELF_HOSTED_ADMIN_KEY=change-me-convex-admin-key

# --- Magnate (RevenueOps — paid courses, entitlements) -----------------------
# Magnate owns billing for the whole platform; AthenIQ never holds Stripe keys.
# Paid-course access is gated on a Magnate plan entitlement (server-to-server):
#   scripts/magnate-entitlements.py check --user <username|email> --plan <slug>
# The token is Magnate's ENTITLEMENTS_API_TOKEN (it also gates /api/purchases,
# which creates one-off course Checkout sessions). Unset on Magnate = open
# (trusted network); set it and use the same value here.
MAGNATE_API_URL=https://app.magnate.innotel.us
MAGNATE_ENTITLEMENTS_TOKEN=
# Plan slug that gates paid courses/tracks (see `make magnate-probe`).
MAGNATE_PAID_PLAN=premium
# Only needed if AthenIQ owns Magnate's single purchase-fulfillment hook;
# verify its callbacks with `magnate-entitlements.py verify-signature`.
MAGNATE_PURCHASE_FULFILLMENT_SECRET=

# --- Open Generative AI (MuAPI media studio) --------------------------------
OPEN_GENERATIVE_AI_URL=http://127.0.0.1:3001

# --- Signara (DocumentOps — signed course certificates) ----------------------
SIGNARA_API_URL=https://api.signara.innotel.us
SIGNARA_API_KEY=change-me-signara-api-key
CERTIFICATE_TEMPLATE_ID=course-completion
# Signatory used by scripts/cert-bridge.py when it creates the signing request
CERT_SIGNER_NAME='D. Hunter'
CERT_SIGNER_EMAIL=dhunter@innotel.us
CERT_SIGNER_TITLE='Founder - Innotel'

# --- Cerulean (TrustOps — DNS / NPM hosts / TLS) ----------------------------
# Used by operator provisioning; see docs/Deployment.md
CERULEAN_DNS_API_URL=http://127.0.0.1:3003
CERULEAN_ADMIN_PASSWORD=change-me-cerulean-admin
CERULEAN_BASE_DOMAIN=learn.innotel.us
CERULEAN_ZONE=innotel.us
CERULEAN_WAN_DISCOVERY_URL=https://api.ipify.org

# --- Cerulean Vault (SecretOps) ---------------------------------------------
# Values live in Cerulean Vault, and this file may name one with a reference
# (`vault://<mount>/<path>#<key>`). Nothing in this stack resolves a reference at
# runtime, so `.env` must hold the resolved value — a reference left in place
# reaches the container as a literal string. Move plaintext secrets in with
# scripts/vault-migrate.py (see docs/stack.md).
VAULT_ADDR=
VAULT_TOKEN_FILE=./data/vault/token/atheniq.token
VAULT_PREFIX=cerulean
VAULT_PATH=atheniq
VAULT_TOKEN=
VAULT_NAMESPACE=
VAULT_SKIP_VERIFY=
VAULT_CACERT=

# --- SMTP (notifications) ---------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AthenIQ <no-reply@learn.innotel.us>"

# --- Misc -------------------------------------------------------------------
ACCESS_CODE=            # optional site-level gate for shared OpenMAIC deployments
# Workforce-tracks catalog (validated by `make check-tracks`).
WORKFORCE_TRACKS_FILE=config/workforce-tracks.json
