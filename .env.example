# ==========================================================================
# AuthenIQ — environment configuration template
# Copy to `.env` (or run ./setup.sh) and fill in real values.
# Never commit `.env`. Production secrets come from Infisical (SecretOps).
# ==========================================================================

# --- General ----------------------------------------------------------------
APP_NAME=AuthenIQ
# Base domains for public surfaces (DNS + TLS provisioned by Cerulean)
BASE_DOMAIN=learn.innotel.us
LMS_HOST=learn.innotel.us
CMS_HOST=studio.innotel.us
CLASSROOM_HOST=classroom.innotel.us

# --- Bind addresses / ports -------------------------------------------------
# OmniRoute model gateway (OpenAI-compatible, dashboard on same port)
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_PORT=20128
OMNIROUTE_API_KEY=change-me-omniroute-api-key
OMNIROUTE_MODEL=auto
REQUIRE_API_KEY=true

# --- Authentik (OIDC identity provider) -------------------------------------
# Cerulean identity provider: application slug `authentiq-lms` registered on
# the shared Authentik (auth.cerulean.innotel.us). Realized values live in
# .env; Open edX is wired via contrib/tutor-ceruleansso (TPA backend `oidc`,
# redirect URIs https://learn.innotel.us/auth/complete/oidc/ + studio).
OIDC_ISSUER_URL=https://auth.cerulean.innotel.us/application/o/authentiq-lms/
OIDC_CLIENT_ID=authentiq-lms
OIDC_CLIENT_SECRET=change-me-oidc-client-secret
OIDC_SCOPES="openid profile email"
IDP_ADMIN_GROUP=authentiq-admins

# --- OpenMAIC (AI classroom) persistence profile ----------------------------
# docker compose --profile openmaic up -d
OPENMAIC_DB_HOST=openmaic-postgres
OPENMAIC_DB_PORT=5433
OPENMAIC_DB_NAME=openmaic
OPENMAIC_DB_USER=openmaic
OPENMAIC_DB_PASSWORD=change-me-openmaic-db
OPENMAIC_DATABASE_URL=postgres://openmaic:change-me-openmaic-db@127.0.0.1:5433/openmaic
PERSISTENCE_DEV_TOKEN=change-me-openmaic-persistence-token

# --- Convex (self-hosted realtime backend) ----------------------------------
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
CONVEX_SELF_HOSTED_ADMIN_KEY=change-me-convex-admin-key
CONVEX_DASHBOARD_PORT=6791

# --- Open Generative AI (MuAPI media studio) --------------------------------
OPEN_GENERATIVE_AI_URL=http://127.0.0.1:3001

# --- Signara (DocumentOps — signed course certificates) ----------------------
SIGNARA_API_URL=http://127.0.0.1:8000/api/v1
SIGNARA_API_KEY=change-me-signara-api-key
CERTIFICATE_TEMPLATE_ID=course-completion

# --- Cerulean (TrustOps — DNS / NPM hosts / TLS) ----------------------------
# Used by operator provisioning; see docs/Deployment.md
CERULEAN_DNS_API_URL=http://127.0.0.1:3003
CERULEAN_ADMIN_PASSWORD=change-me-cerulean-admin
CERULEAN_BASE_DOMAIN=learn.innotel.us
CERULEAN_ZONE=innotel.us
CERULEAN_WAN_DISCOVERY_URL=https://api.ipify.org

# --- Infisical (SecretOps) --------------------------------------------------
INFISICAL_ENCRYPTION_KEY=
INFISICAL_AUTH_SECRET=
INFISICAL_DB_PASSWORD=
INFISICAL_ORG=Innotel

# --- SMTP (notifications) ---------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AuthenIQ <no-reply@learn.innotel.us>"

# --- Misc -------------------------------------------------------------------
ACCESS_CODE=            # optional site-level gate for shared OpenMAIC deployments
