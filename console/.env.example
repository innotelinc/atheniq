# AthenIQ console — optional defaults for the first boot.
# Everything here can also be set in the app under Integrations; values saved
# there take precedence over these after the first run.

# --- Model gateway (OpenAI-compatible; OmniRoute in the AthenIQ stack) -------
OMNIROUTE_BASE_URL=http://192.168.1.71:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto

# --- Signara (DocumentOps — signed certificates) -----------------------------
SIGNARA_API_URL=https://api.signara.innotel.us
SIGNARA_API_KEY=
# ISO date the current key stops working; drives the rotation warning.
SIGNARA_KEY_EXPIRES_AT=
# Enables one-click rotation from /health. This is the Signara JWT access
# secret (cerulean/signara -> JWT_ACCESS_SECRET): the console signs a 5-minute
# admin JWT to mint a key. It is never written to the store or shown in the UI.
SIGNARA_ADMIN_SECRET=
SIGNARA_ADMIN_EMAIL=dhunter@innotel.us
# Scopes requested for a rotated key; defaults to the award set (documents + signing).
SIGNARA_KEY_SCOPES=

# --- Operations digest (weekly email) ---------------------------------------
# Any relay that accepts POST {from,to,subject,text,html} with a bearer key.
# Outbound mail: either SMTP submission or an HTTP relay, whichever is set.
# This deployment submits through the school's Stalwart server on 465.
MAIL_SMTP_HOST=mail.innotel.us
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURE=1
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_FROM=
# HTTP relay instead of SMTP: Resend is the default endpoint.
MAIL_API_KEY=
MAIL_API_URL=https://api.resend.com/emails
DIGEST_TO=dhunter@innotel.us
# Bearer token a scheduler can use: POST /api/health/digest?token=…
DIGEST_TOKEN=

# --- Public website (white-label) -------------------------------------------
# Hosts answered as the public site, comma-separated. The console host is not
# listed here, so it keeps serving the registrar console.
PUBLIC_SITE_HOSTS=atheniq.institute,www.atheniq.institute
PUBLIC_SITE_DOMAIN=atheniq.institute

# --- Signatory on signing requests -------------------------------------------
CERT_SIGNER_NAME=D. Hunter
CERT_SIGNER_TITLE=Founder - Innotel
CERT_SIGNER_EMAIL=dhunter@innotel.us

# --- Console sign-in ---------------------------------------------------------
# Set AUTH_PASSWORD to require a sign-in before anyone can publish courses or
# award credentials. Leave it empty and the console stays open (local dev).
# /verify stays public in both cases so employers can check a credential.
#
# The password bootstraps one registrar account (Staff -> Accounts); everyone
# else is added there with their own password and role. Every publish and award
# records which account did it.
AUTH_PASSWORD=
AUTH_EMAIL=dhunter@innotel.us
AUTH_NAME=D. Hunter
AUTH_TITLE=Registrar, AthenIQ Institute
# Optional: sign session cookies with a separate secret (recommended anywhere
# other than localhost). Falls back to AUTH_PASSWORD when unset.
AUTH_SECRET=

# --- Who may sign in ---------------------------------------------------------
# Only staff emails ending with one of these domains are accepted, at account
# creation and at sign-in. Comma-separated; subdomains are allowed.
STAFF_EMAIL_DOMAINS=innotel.us,atheniq.institute
# Two-factor (TOTP) is required by default: an unenrolled account is walked
# through enrolment at its first sign-in (QR or key, then a code). Set to "off"
# to let the password sign in until the person enrols from /security.
AUTH_REQUIRE_2FA=on

# --- Vaultwarden -------------------------------------------------------------
# Every new staff account gets a matching vault account linked to it. The
# address is registered with the password the console was given (or a generated
# one for approved access requests, shown once to the approving registrar).
VAULTWARDEN_URL=https://vault.innotel.us
# Set to 1 to stop creating vault accounts without removing the config.
VAULTWARDEN_DISABLE=

# --- Console address ---------------------------------------------------------
# Origin the console answers on, used for links in alert email. Defaults to the
# registrar subdomain of PUBLIC_SITE_DOMAIN; set it when the console lives
# somewhere else.
CONSOLE_ORIGIN=https://registrar.atheniq.institute

# --- Course checkout (app) ---------------------------------------------------
# Hosted checkout for priced courses, used by the mobile API. Optional: without
# it the app shows the payment reference and a claim form instead. Placeholders
# {reference}, {amount}, {course} and {title} are filled in per enrolment.
CHECKOUT_URL=
