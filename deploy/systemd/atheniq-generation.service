[Unit]
Description=AthenIQ course-generation console (staff screen for OpenMAIC classrooms)
After=network-online.target docker.service
Wants=network-online.target

[Service]
# Long-running: the SSO proxy in front of it dials it, and the page polls it
# while a classroom generates. It holds no model credential of its own — every
# generation goes through OpenMAIC's API on this host's loopback, and who may
# start one is decided by the identity headers the proxy sets (see
# docs/Deployment.md §"Course-generation console").
#
# The values below are the deployment's; the unit ships with the paths this
# box uses. Copy to /etc/systemd/system/ and adjust GENERATION_BIND /
# GENERATION_ROOT / GENERATION_ALLOWED_GROUPS for another host.
#
# The two integrations a program touches need credentials the unit itself must
# not carry: Signara signs the conferred degree, and Authentik receives the
# paid-course entitlement. `-` keeps the service startable on a host without
# the file (conferral then reports `skipped`, it does not fail).
EnvironmentFile=-/usr/src/projects/complete/atheniq/.env
Environment=PYTHONUNBUFFERED=1
Environment=OPENMAIC_BASE_URL=http://127.0.0.1:3000
Environment=GENERATION_BIND=192.168.1.59
Environment=GENERATION_PORT=8090
# Staff, and only staff: the door in front of this host admits every AthenIQ
# account (the portal they land on is theirs), and these two lists are what make
# the console and its deep tools staff-only. `AthenIQ` used to be named here and
# in the door's `--allowed-group`; no such group exists in Authentik, so it
# granted nobody anything and the door refused every non-admin after a good
# sign-in. A name that cannot be held is not a policy.
Environment=GENERATION_ALLOWED_GROUPS=atheniq-admins
Environment=GENERATION_ROOT=/home/tutor/atheniq-generation
Environment=CLASSROOM_HOST=https://classroom.innotel.us
# A finished classroom is written into its spec without waiting for the page.
# 0 disables the sweeper; the page's own poll still records.
Environment=GENERATION_AUTORECORD_SECONDS=20
# The run -> spec map, so a restart does not forget a classroom that finished.
Environment=GENERATION_STATE=/var/lib/atheniq-generation/runs.json
# Every course a program creates is also published into the LMS, so it lists in
# Explore courses and a learner can be enrolled (which is what fills My courses).
# Generated classrooms are then written into those courses as lessons and a
# graded final examination, and the LMS grade is read back as the completion.
# This needs `docker` for the unit's user and the directory below, owned by it.
Environment=GENERATION_PUBLISH=1
Environment=GENERATION_LMS_DIR=/home/tutor/atheniq-generation/lms
StateDirectory=atheniq-generation
StateDirectoryMode=0750
ExecStart=/usr/bin/python3 /home/tutor/atheniq-generation/scripts/generation-console.py
Restart=on-failure
RestartSec=5
User=tutor

[Install]
WantedBy=multi-user.target
