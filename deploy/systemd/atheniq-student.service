[Unit]
Description=AthenIQ learner portal (programs and courses at lms.innotel.us)
After=network-online.target
Wants=network-online.target

[Service]
# Public and read-only: the catalog a learner reads before signing in. It
# serves web/student/ and three JSON views over programs/ and courses/, and it
# never touches enrollments, grades or the signing configuration.
Environment=PYTHONUNBUFFERED=1
Environment=STUDENT_BIND=192.168.1.59
Environment=STUDENT_PORT=8092
Environment=STUDENT_ROOT=/home/tutor/atheniq-generation
Environment=CLASSROOM_HOST=https://classroom.innotel.us
ExecStart=/usr/bin/python3 /home/tutor/atheniq-generation/scripts/student-portal.py
Restart=on-failure
RestartSec=5
User=tutor

[Install]
WantedBy=multi-user.target
